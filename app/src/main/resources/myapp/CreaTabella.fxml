<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<DialogPane prefWidth="480.0" prefHeight="360.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="myapp.controllers.CreaTabella">
    <content>
        <VBox spacing="14.0" styleClass="surface-panel">
            <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0" /></padding>
            <Label text="Nuovo archivio" styleClass="section-title" />
            <Label text="Crea una tabella prodotti con colonne nome e prezzo." styleClass="muted-label" wrapText="true" />
            <TextField fx:id="fieldNomedatabase" promptText="Nome tabella" maxWidth="1.7976931348623157E308" />
            <TextField fx:id="fieldNome" promptText="Nome prodotto (opzionale)" maxWidth="1.7976931348623157E308" />
            <TextField fx:id="fieldCognome" promptText="Prezzo FLOAT (opzionale)" maxWidth="1.7976931348623157E308" />
            <Button fx:id="creaDatabase" mnemonicParsing="false" onAction="#creaDatabase" text="Crea tabella" maxWidth="1.7976931348623157E308" styleClass="primary-button" />
        </VBox>
    </content>
</DialogPane>
